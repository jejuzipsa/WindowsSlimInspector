<Window x:Class="WindowsSlimInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsSlimInspector" Height="760" Width="920" MinHeight="680" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Windows Slim" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="불필요한 Windows 온라인/추천 기능만 선택적으로 관리합니다. 핵심 시스템 기능은 건드리지 않습니다."
                       Margin="0,6,0,12" Foreground="DimGray"/>
            <CheckBox x:Name="SelectAllCheckBox" Content="전체 선택" FontWeight="SemiBold" Checked="SelectAllChanged" Unchecked="SelectAllChanged"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,12" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FeaturePanel"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2">
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                <Button Content="상태 새로고침" Width="135" Margin="5" Padding="10,7" Click="RefreshStatus_Click"/>
                <Button Content="선택 끄기" Width="135" Margin="5" Padding="10,7" Click="DisableSelected_Click"/>
                <Button Content="선택 복구" Width="135" Margin="5" Padding="10,7" Click="RestoreSelected_Click"/>
            </WrapPanel>

            <Separator Margin="0,2,0,14"/>

            <TextBlock Text="PC 전체 검사" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="프로세스, 서비스, 시작프로그램, 예약 작업, 네트워크, 보안 상태 등을 읽기 전용으로 검사하고 TXT 로그를 생성합니다."
                       Margin="0,5,0,10" Foreground="DimGray" TextWrapping="Wrap"/>
            <WrapPanel>
                <Button Content="PC 전체 검사 및 로그 내보내기" Width="250" Padding="10,8" Click="RunInspection_Click"/>
                <TextBlock x:Name="InspectionStatusText" Margin="14,9,0,0" Foreground="DimGray"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
