<Window x:Class="WindowsSlimInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsSlimInspector" Height="820" Width="1000" MinHeight="720" MinWidth="880"
        WindowStartupLocation="CenterScreen" Background="#101722" Foreground="#EAF0F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#172231"/><SolidColorBrush x:Key="BorderBrushDark" Color="#334257"/><SolidColorBrush x:Key="MutedBrush" Color="#AAB6C7"/>
        <Style TargetType="Button"><Setter Property="Background" Value="#26364B"/><Setter Property="Foreground" Value="#F2F6FB"/><Setter Property="BorderBrush" Value="#52647C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="5"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F6FB"/></Style>
        <Style TargetType="Separator"><Setter Property="Background" Value="#334257"/><Setter Property="Margin" Value="0,5"/></Style>
        <Style x:Key="DarkProgress" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#8F2F3B"/><Setter Property="Background" Value="#0B121C"/><Setter Property="BorderBrush" Value="#26364B"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Windows Slim" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="불필요한 Windows 온라인/추천 기능만 선택적으로 관리합니다. 핵심 시스템 기능은 건드리지 않습니다." Margin="0,6,0,12" Foreground="{StaticResource MutedBrush}"/><CheckBox x:Name="SelectAllCheckBox" Content="전체 선택" FontWeight="SemiBold" Checked="SelectAllChanged" Unchecked="SelectAllChanged"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Background="#182536" BorderBrush="#40516A" BorderThickness="1" CornerRadius="8" Padding="18,8" Margin="5"><StackPanel><TextBlock Text="관리 대상" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="TotalCountText" Text="0개" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Background="#153528" BorderBrush="#28694B" BorderThickness="1" CornerRadius="8" Padding="18,8" Margin="5"><StackPanel><TextBlock Text="활성" Foreground="#7DE3A8" HorizontalAlignment="Center"/><TextBlock x:Name="ActiveCountText" Text="0개" FontSize="20" FontWeight="Bold" Foreground="#7DE3A8" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Background="#3A2026" BorderBrush="#82414D" BorderThickness="1" CornerRadius="8" Padding="18,8" Margin="5"><StackPanel><TextBlock Text="비활성" Foreground="#FF8C98" HorizontalAlignment="Center"/><TextBlock x:Name="InactiveCountText" Text="0개" FontSize="20" FontWeight="Bold" Foreground="#FF8C98" HorizontalAlignment="Center"/></StackPanel></Border>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="0,14,0,12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FeaturePanel"/></ScrollViewer></Border>
        <StackPanel Grid.Row="2">
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8"><Button Content="상태 새로고침" Width="150" Click="RefreshStatus_Click"/><Button Content="선택 끄기" Width="150" Click="DisableSelected_Click"/><Button Content="선택 복구" Width="150" Click="RestoreSelected_Click"/></WrapPanel>
            <TextBlock x:Name="ActionStatusText" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/><Separator Margin="0,2,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PC 전체 검사" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="프로세스, 서비스, 시작프로그램, 예약 작업, 네트워크, 보안 상태 등을 읽기 전용으로 검사하고 TXT 로그를 생성합니다." Margin="0,5,0,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="로그 폴더 열기" Width="130" Click="OpenLogs_Click"/></Grid>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="InspectionButton" Content="PC 전체 검사 시작" Margin="0,0,12,0" Click="RunInspection_Click"/><StackPanel Grid.Column="1"><Grid><TextBlock x:Name="InspectionStatusText" Text="대기 중" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="InspectionElapsedText" Text="0초" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid><ProgressBar x:Name="InspectionProgress" Style="{StaticResource DarkProgress}" Height="12" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0"/></StackPanel></Grid></Border>
        </StackPanel>
    </Grid>
</Window>
